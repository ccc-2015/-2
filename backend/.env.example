# 模型服务（OpenAI 兼容）。密钥仅服务端持有，切勿提交真实值或写入前端。
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=glm-5.3-flash
# 默认 https://api.openai.com/v1；DeepSeek/Kimi/通义/智谱等填对应 base_url
MODEL_API_BASE_URL=https://x.ailzd.com/v1
MODEL_TIMEOUT_MS=180000
# 推理强度：minimal 关闭冗余推理、显著提速（实测 63s→16s）；留空则不发送该参数
MODEL_REASONING_EFFORT=minimal

# 服务监听
HOST=127.0.0.1
PORT=8000