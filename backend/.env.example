# ===== 三套模型完全独立：文字 / 向量 / 精排，各自 URL 与 Key，互不兜底 =====

# --- 1. 文字模型（合同与争议分析），OpenAI 兼容 /chat/completions ---
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=glm-5.3-flash
# 默认 https://api.openai.com/v1；DeepSeek/Kimi/通义/智谱等填对应 base_url
MODEL_API_BASE_URL=https://x.ailzd.com/v1
MODEL_TIMEOUT_MS=180000
# 推理强度：minimal 关闭冗余推理、显著提速（实测 63s→16s）；留空则不发送该参数
MODEL_REASONING_EFFORT=minimal

# 服务监听
HOST=127.0.0.1
PORT=8000

# --- 2. 向量模型（知识库语义召回），OpenAI 兼容 /embeddings ---
# 三项齐全时走远程；任一项留空则回退本地 fastembed BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_NAME=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
# 必须与模型实际输出维度一致；换模型要重建向量（见 data/README.md）
EMBEDDING_DIM=512
EMBEDDING_MIN_SCORE=0.2
EMBEDDING_TIMEOUT_MS=15000
# 单次请求的最大文本条数，入库时按批切分
EMBEDDING_BATCH_SIZE=16

# 本地向量兜底（远程未配置时生效）；首次使用会从镜像下载约 100MB
MODEL_EMBEDDING_NAME=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# --- 3. 精排序模型（rerank），OpenAI 兼容 POST /rerank ---
# 三项齐全才启用；缺任意一项即跳过精排，直接用向量+关键词融合顺序
RERANK_MODEL_NAME=
RERANK_API_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT_MS=8000
# 送入精排的候选数（从粗排取前 N 条重排），需 ≥ 最终返回条数
RERANK_CANDIDATES=12
# 精排分数下限，低于该值的候选会被丢弃；0 表示不设阈值
RERANK_MIN_SCORE=0.0

# --- 知识库存储 ---
# 未配置 DATABASE_URL 或 KNOWLEDGE_BACKEND=json 时，回退文件型 JSON 知识库
KNOWLEDGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/zzyj